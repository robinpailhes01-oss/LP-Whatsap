# ============================================================================
# Destination des demandes d'essai (formulaire en bas de page).
# Sans l'une de ces deux options, le formulaire affiche « pas de destination »
# au lieu de faire croire à un envoi réussi.
#
# En local : copier ce fichier en .env.local et remplir.
# Sur Vercel : Settings → Environment Variables, puis redéployer.
# ============================================================================

# ---------------------------------------------------------------------------
# OPTION A — recevoir un e-mail, via Resend (resend.com)
# ---------------------------------------------------------------------------
# 1. Créer un compte Resend avec l'adresse où vous voulez recevoir les demandes.
# 2. API Keys → Create API Key → copier la clé (elle commence par re_).
# 3. Remplir les trois lignes ci-dessous.
#
# Pour démarrer sans toucher au DNS, laisser LEAD_EMAIL_FROM sur l'adresse de
# test de Resend : elle fonctionne immédiatement, mais n'envoie qu'à l'adresse
# du compte Resend — ce qui est exactement le besoin ici.
# Plus tard, vérifier votre domaine chez Resend et passer sur une adresse à
# vous (luma@luma-agence.fr) pour un rendu plus propre.

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
LEAD_EMAIL_TO="vous@exemple.fr"          # plusieurs adresses : séparer par des virgules
LEAD_EMAIL_FROM="onboarding@resend.dev"  # puis, domaine vérifié : luma@luma-agence.fr

# ---------------------------------------------------------------------------
# OPTION B — envoyer vers un webhook (Make, n8n, Zapier…)
# ---------------------------------------------------------------------------
# Prioritaire sur l'option A si les deux sont renseignées.
# Laisser vide pour recevoir un e-mail.

# LEAD_WEBHOOK_URL="https://hook.eu2.make.com/xxxxxxxx"
